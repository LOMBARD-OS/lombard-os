# =============================================================================
# .env.example  —  Lombard OS recruitment loop (local session)
# Copy to .env and fill in REAL values locally. NEVER commit the filled .env.
# (.env is gitignored — see .gitignore)
# These were NOT present in the cloud sandbox; that is why the loop stalled.
# =============================================================================

# ---- Recruitly (ATS: pipeline read, post job, add candidates, message) ------
# Public REST API base is https://api.recruitly.io ; auth via apiKey.
RECRUITLY_API_KEY=
RECRUITLY_BASE_URL=https://api.recruitly.io
RECRUITLY_SUBDOMAIN=

# ---- "turnover" (job board / outreach) --------------------------------------
# CONFIRM the actual platform + whether it exposes an API before use.
TURNOVER_BASE_URL=
TURNOVER_API_KEY=
TURNOVER_USERNAME=
TURNOVER_PASSWORD=

# ---- Microsoft Graph (Teams + Outlook calendar = book the 9-11 holds) -------
# App registration (client credentials) OR a delegated user token.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_CALENDAR_USER=joseph.marsden@lombard-tech.io   # diary to write events into

# ---- Apollo.io (sourcing + enrich + email sequencing) -----------------------
# Needs LEAD CREDITS topped up AND a linked sending mailbox in Apollo.
APOLLO_API_KEY=

# ---- Notion (optional: pipeline mirror) -------------------------------------
# Querying needs Business plan + Notion AI on the workspace.
NOTION_API_KEY=
